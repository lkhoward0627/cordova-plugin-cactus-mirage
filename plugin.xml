<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="cordova-plugin-cactus-mirage"
        version="1.0.0">
    <name>Cactus Mirage VLM Plugin</name>
    <description>On-Device VLM Inference for OutSystems Mobile Apps</description>
    <license>MIT</license>

    <js-module src="www/CactusMirage.js" name="CactusMirage">
        <clobbers target="cordova.plugins.CactusMirage" />
    </js-module>

    <!-- Android Platform Configuration -->
    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="CactusMiragePlugin">
                <param name="android-package" value="com.cactus.mirage.CactusMiragePlugin" />
            </feature>
        </config-file>

        <!-- Native Java Bridge -->
        <source-file src="src/android/CactusMiragePlugin.java" target-dir="src/com/cactus/mirage" />
        
        <!-- Native C++ Compiled Shared Object (.so) for ARM64 -->
        <source-file src="src/android/libs/arm64-v8a/libcactus_engine.so" target-dir="libs/arm64-v8a" />
        
        <!-- Model Weights File bundled in APK Assets -->
        <asset src="src/android/assets/mirage.cact" target="mirage.cact" />
    </platform>
</plugin>
